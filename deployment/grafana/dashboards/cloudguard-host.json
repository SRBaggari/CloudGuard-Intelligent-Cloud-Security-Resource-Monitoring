{
  "title": "CloudGuard Host Metrics",
  "uid": "cloudguard-host",
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU %",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudguard-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cloudguard_host_cpu_percent",
          "datasource": {
            "type": "prometheus",
            "uid": "cloudguard-prom"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory %",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudguard-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cloudguard_host_memory_percent",
          "datasource": {
            "type": "prometheus",
            "uid": "cloudguard-prom"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Disk %",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudguard-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cloudguard_host_disk_percent",
          "datasource": {
            "type": "prometheus",
            "uid": "cloudguard-prom"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Processes",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudguard-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cloudguard_host_process_count",
          "datasource": {
            "type": "prometheus",
            "uid": "cloudguard-prom"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Download rate",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudguard-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cloudguard_host_net_recv_bytes_per_second",
          "datasource": {
            "type": "prometheus",
            "uid": "cloudguard-prom"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Upload rate",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudguard-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cloudguard_host_net_send_bytes_per_second",
          "datasource": {
            "type": "prometheus",
            "uid": "cloudguard-prom"
          }
        }
      ]
    }
  ]
}
