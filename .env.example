# ---------------------------------------------------------------------------
# CloudGuard configuration. Copy to backend/.env (or project root .env) and edit.
# NEVER commit real credentials.
# ---------------------------------------------------------------------------
APP_ENV=development

# PostgreSQL (recommended). Create the DB first, e.g.:
#   psql -U postgres -c "CREATE USER cloudguard WITH PASSWORD 'change-me';"
#   psql -U postgres -c "CREATE DATABASE cloudguard OWNER cloudguard;"
DATABASE_URL=postgresql+psycopg://cloudguard:change-me@localhost:5432/cloudguard
# For a quick local run without PostgreSQL you may use SQLite instead:
# DATABASE_URL=sqlite:///./data/cloudguard.db
AUTO_MIGRATE=true

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_DEFAULT_PER_MINUTE=600

# real = psutil + Docker Engine + VirtualBox; mock = labelled demo adapters (testing/demo only)
INTEGRATION_MODE=real
ENABLE_BACKGROUND_TASKS=true
DOCKER_ENABLED=true
VIRTUALBOX_ENABLED=true
# Optional explicit path, e.g. C:\Program Files\Oracle\VirtualBox\VBoxManage.exe
VBOXMANAGE_PATH=

METRICS_INTERVAL_SECONDS=5
CONTAINER_POLL_INTERVAL_SECONDS=15
METRICS_RETENTION_DAYS=30

PROMETHEUS_ENABLED=true
# If set, Prometheus must send "Authorization: Bearer <token>"
PROMETHEUS_TOKEN=

# Used by docker-compose only
POSTGRES_USER=cloudguard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cloudguard
GRAFANA_ADMIN_PASSWORD=change-me
